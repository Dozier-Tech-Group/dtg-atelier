# Copy to .env and fill in locally. Never commit .env. Never paste a key into chat.
#
# Canonical secret storage is Azure Key Vault in the DTG Platform subscription
# (see infra/azure/README.md and Dozier-Tech-Group/DTG-Infra). This file holds
# pointers and local-only values — the repo never holds secrets.

# Hex private key of the deployer (with or without 0x). Contributors leave blank.
# Production keys live in Key Vault; pull locally only when deploying.
PRIVATE_KEY=

# --- Networks (all optional; sensible public defaults in hardhat.config.js) ---
# Robinhood Chain mainnet (chain ID 4663, gas in ETH):
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Robinhood Chain testnet (chain ID 46630):
# RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# SEPOLIA_RPC_URL=
# BASE_RPC_URL=
# BASE_SEPOLIA_RPC_URL=

# --- Drop configuration ---
# Deploy scripts read drop.config.json (copy drop.config.example.json).
# Metadata base URI with trailing slash. tokenURI(1) => {BASE_URI}1.json
# BASE_URI=

# --- Azure (DTG Platform estate — pointers, not secrets) ---
# Tenant doziertechgroup.com: a0844ee1-d6d6-47c5-8fa8-69302b3ddd27
# Subscription "DTG Platform":  ea96e212-9b00-4e93-9d3b-9018638cee20
# AZURE_KEY_VAULT_NAME=
# AZURE_STORAGE_ACCOUNT=

# --- Firecrawl (market research; see research/firecrawl/README.md) ---
# FIRECRAWL_API_KEY=
