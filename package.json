{
  "name": "dtg-atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Dozier Tech Group's foundry for launching any token or NFT collection — safe by construction, designed before minted.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint \"contracts/**/*.sol\"",
    "security": "solhint \"contracts/**/*.sol\" && hardhat test",
    "deploy:token:testnet": "hardhat run scripts/deploy-token.js --network robinhoodTestnet",
    "deploy:token:mainnet": "hardhat run scripts/deploy-token.js --network robinhood",
    "deploy:drop:testnet": "hardhat run scripts/deploy-drop.js --network robinhoodTestnet",
    "deploy:drop:mainnet": "hardhat run scripts/deploy-drop.js --network robinhood",
    "deploy:editions:testnet": "hardhat run scripts/deploy-editions.js --network robinhoodTestnet",
    "deploy:editions:mainnet": "hardhat run scripts/deploy-editions.js --network robinhood",
    "deploy:drop:sepolia": "hardhat run scripts/deploy-drop.js --network sepolia",
    "deploy:drop:base": "hardhat run scripts/deploy-drop.js --network base",
    "research": "node research/firecrawl/crawl.mjs",
    "design:board": "npx --yes serve design -p 4174"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.2.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.3",
    "solhint": "^5.2.0"
  }
}
